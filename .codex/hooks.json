{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/hooks/session-start\"",
            "statusMessage": "Loading Gummy context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/hooks/codex-stop\"",
            "statusMessage": "Persisting Gummy turn state",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
