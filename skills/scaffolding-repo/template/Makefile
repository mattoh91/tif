SHELL := /usr/bin/env bash

.PHONY: init fmt lint typecheck test smoke ci

init:
	./init.sh

fmt:
	@echo "No formatter configured. Replace this target with the project formatter."
	@exit 1

lint:
	@echo "No linter configured. Replace this target with the project linter."
	@exit 1

typecheck:
	@echo "No typechecker configured. Replace this target with the project typecheck command."
	@exit 1

test:
	@echo "No test command configured. Replace this target with the project test command."
	@exit 1

smoke:
	@echo "No smoke check configured. Replace this target with the lowest-cost runnable health check."
	@exit 1

ci: lint typecheck test smoke
