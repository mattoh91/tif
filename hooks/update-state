#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
silent=0
if [ "$mode" = "--hook" ]; then
  silent=1
fi

project_slug() {
  local remote
  remote="$(git remote get-url origin 2>/dev/null || true)"
  if [ -n "$remote" ]; then
    printf '%s' "$remote" \
      | sed -E 's#^[a-zA-Z]+://##; s#^git@##; s#:#/#; s#\.git$##; s#[^A-Za-z0-9._/-]+#-#g; s#[/]+#-#g' \
      | tr '[:upper:]' '[:lower:]'
  else
    basename "$(pwd)" | tr '[:upper:]' '[:lower:]' | sed -E 's#[^a-z0-9._-]+#-#g'
  fi
}

has_cutiepie_file() {
  local rel="$1"
  [ -f ".cutiepie/docs/${rel}" ]
}

first_cutiepie_file() {
  local rel="$1"
  if [ -f ".cutiepie/docs/${rel}" ]; then
    printf '.cutiepie/docs/%s' "$rel"
  fi
}

append_issue() {
  local severity="$1"
  local message="$2"
  issue_count=$((issue_count + 1))
  printf -- '- [%s] %s\n' "$severity" "$message" >> "$issues_tmp"
}

script_dir="$(cd "$(dirname "$0")" && pwd)"
slug="$(project_slug)"
memory_dir="${HOME}/.cutiepie/memory/${slug}"
session_dir="${memory_dir}/SESSIONS"
mkdir -p "$session_dir"

now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
today="$(date -u +%Y-%m-%d)"
audit_file="${memory_dir}/STATE_AUDIT.md"
preamble_file="${memory_dir}/PREAMBLE.md"
session_file="${session_dir}/${today}.md"
issues_tmp="$(mktemp)"
validator_tmp="$(mktemp)"
trap 'rm -f "$issues_tmp" "$validator_tmp"' EXIT
issue_count=0

git_status="$(git status --short 2>/dev/null || true)"
changed_files="$({
  git diff --name-only HEAD 2>/dev/null || true
  git ls-files --others --exclude-standard 2>/dev/null || true
} | sort -u)"
recent_commits="$(git log --oneline -8 2>/dev/null || true)"

if [ ! -f "${memory_dir}/MEMORY.md" ]; then
  printf '# Cutiepie Memory\n' > "${memory_dir}/MEMORY.md"
fi

if [ ! -f "${memory_dir}/FAILURES.md" ]; then
  printf '# Cutiepie Failure Modes\n' > "${memory_dir}/FAILURES.md"
fi

if [ -n "$git_status" ]; then
  append_issue "attention" "Working tree has uncommitted changes; review or commit before clearing context."
fi

if [ -x "${script_dir}/../scripts/check-cutiepie-state.sh" ]; then
  "${script_dir}/../scripts/check-cutiepie-state.sh" . > "$validator_tmp" || true
  while IFS= read -r validator_line; do
    case "$validator_line" in
      "- [ok]"*)
        ;;
      "- ["*)
        issue_count=$((issue_count + 1))
        printf '%s\n' "$validator_line" >> "$issues_tmp"
        ;;
    esac
  done < "$validator_tmp"
fi

if [ -n "$changed_files" ]; then
  if printf '%s\n' "$changed_files" | grep -Eq '(^|/)(src|app|lib|packages|cmd|internal|components|pages|routes|api|server|client|tests?)/|\.([cm]?[jt]sx?|py|go|rs|java|kt|rb|php|swift|cs|cpp|h|hpp)$'; then
    if ! printf '%s\n' "$changed_files" | grep -Eq '(^|/)\.cutiepie/(docs|plans)/'; then
      append_issue "possible-stale" "Code/test files changed without Cutiepie story/docs state in the current diff; check affected specs, contracts, ADR, architecture, and config."
    fi
  fi
fi

if has_cutiepie_file "CONFIG.md"; then
  config_file="$(first_cutiepie_file "CONFIG.md")"
  if ! grep -Eiq 'settings|config|hyperparameter|tunable|default|allowed|owner' "$config_file" 2>/dev/null; then
    append_issue "possible-stale" "${config_file} does not appear to document settings owners, defaults, or tunables."
  fi
fi

if has_cutiepie_file "ARCHI.md"; then
  archi_file="$(first_cutiepie_file "ARCHI.md")"
  if ! grep -Eq '<mxfile|drawio|draw\.io|```mermaid|graph |flowchart |sequenceDiagram|C4Context|C4Container' "$archi_file" 2>/dev/null; then
    append_issue "possible-stale" "${archi_file} does not appear to contain a draw.io dataflow diagram or supported diagram source."
  fi
fi

if [ -d ".cutiepie/plans" ]; then
  while IFS= read -r story_adr; do
    if ! grep -Eiq 'decision|options|consequence|status' "$story_adr" 2>/dev/null; then
      append_issue "possible-stale" "${story_adr} does not appear to record decisions/options/consequences."
    fi
  done < <(find .cutiepie/plans -maxdepth 2 -type f -name ADR.md 2>/dev/null | sort)
fi

{
  printf '# Cutiepie State Audit\n\n'
  printf 'Generated: %s\n' "$now"
  printf 'Project: %s\n' "$slug"
  printf 'Working directory: %s\n\n' "$(pwd)"
  printf '## Issues\n\n'
  if [ "$issue_count" -eq 0 ]; then
    printf -- '- [ok] No obvious stale-state issues detected by static checks.\n'
  else
    cat "$issues_tmp"
  fi
  printf '\n## Git Status\n\n'
  if [ -n "$git_status" ]; then
    printf '```text\n%s\n```\n' "$git_status"
  else
    printf 'Clean.\n'
  fi
  printf '\n## Changed Files\n\n'
  if [ -n "$changed_files" ]; then
    printf '```text\n%s\n```\n' "$changed_files"
  else
    printf 'None relative to HEAD.\n'
  fi
  printf '\n## Recent Commits\n\n'
  if [ -n "$recent_commits" ]; then
    printf '```text\n%s\n```\n' "$recent_commits"
  else
    printf 'Unavailable.\n'
  fi
} > "$audit_file"

{
  printf '<cutiepie-preamble>\n'
  printf 'Project: %s\n' "$slug"
  printf 'Generated: %s\n' "$now"
  printf 'Current state: See %s\n' "$audit_file"
  printf 'Working tree: '
  if [ -n "$git_status" ]; then
    printf 'dirty; inspect git status before continuing.\n'
  else
    printf 'clean.\n'
  fi
  printf 'State issues:\n'
  if [ "$issue_count" -eq 0 ]; then
    printf -- '- No obvious stale-state issues detected by static checks.\n'
  else
    cat "$issues_tmp"
  fi
  printf 'Recent commits:\n'
  if [ -n "$recent_commits" ]; then
    printf '%s\n' "$recent_commits" | sed 's/^/- /'
  else
    printf -- '- Unavailable.\n'
  fi
  printf 'Next session checklist:\n'
  printf -- '- Read .cutiepie/docs/PRD.md for project mode, context, and stories.\n'
  printf -- '- Read .cutiepie/plans/story_*/plan.md for story workflow.\n'
  printf -- '- Read .cutiepie/plans/story_*/specs/spec_*.md for completed flags and acceptance checks.\n'
  printf -- '- Read .cutiepie/plans/story_*/contracts.json for cross-spec schemas.\n'
  printf -- '- Read .cutiepie/docs/CONFIG.md for env vars, settings owners, MCP setup, and tunables.\n'
  printf -- '- Read %s and update stale docs or memory before implementation.\n' "$audit_file"
  printf -- '- Do not mark a spec completed=true until all acceptance checks pass.\n'
  printf '</cutiepie-preamble>\n'
} > "$preamble_file"

{
  printf '\n## Cutiepie Update State — %s\n\n' "$now"
  printf -- '- Event: %s\n' "${CUTIEPIE_HOOK_EVENT:-manual}"
  printf -- '- Audit: %s\n' "$audit_file"
  printf -- '- Preamble: %s\n' "$preamble_file"
  printf -- '- Issues: %s\n' "$issue_count"
} >> "$session_file"

if [ "$silent" -eq 0 ]; then
  printf 'Cutiepie state refreshed.\n'
  printf 'Audit: %s\n' "$audit_file"
  printf 'Preamble: %s\n' "$preamble_file"
  printf 'Issues: %s\n' "$issue_count"
fi
