#!/usr/bin/env bash
# SessionStart hook for Tif plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Check if legacy skills directory exists and build warning
warning_message=""
legacy_skills_dir="${HOME}/.config/tif/skills"
if [ -d "$legacy_skills_dir" ]; then
    warning_message="\n\n<important-reminder>IN YOUR FIRST REPLY AFTER SEEING THIS MESSAGE YOU MUST TELL THE USER:⚠️ **WARNING:** Tif now uses Claude Code's skills system. Custom skills in ~/.config/tif/skills will not be read. Move custom skills to ~/.claude/skills instead. To make this message go away, remove ~/.config/tif/skills</important-reminder>"
fi

# Read using-tif content
using_tif_content=$(cat "${PLUGIN_ROOT}/skills/using-tif/SKILL.md" 2>&1 || echo "Error reading using-tif skill")

project_slug() {
    local remote
    remote="$(git remote get-url origin 2>/dev/null || true)"
    if [ -n "$remote" ]; then
        printf '%s' "$remote" \
            | sed -E 's#^[a-zA-Z]+://##; s#^git@##; s#:#/#; s#\.git$##; s#[^A-Za-z0-9._/-]+#-#g; s#[/]+#-#g' \
            | tr '[:upper:]' '[:lower:]'
    else
        basename "$(pwd)" | tr '[:upper:]' '[:lower:]' | sed -E 's#[^a-z0-9._-]+#-#g'
    fi
}

append_if_exists() {
    local title="$1"
    local file="$2"
    local max_lines="${3:-120}"

    if [ -f "$file" ]; then
        printf '\n## %s\n\n' "$title"
        sed -n "1,${max_lines}p" "$file"
        line_count="$(wc -l < "$file" | tr -d ' ')"
        if [ "$line_count" -gt "$max_lines" ]; then
            printf '\n[Truncated to first %s lines of %s]\n' "$max_lines" "$file"
        fi
    fi
}

append_story_state() {
    if [ ! -d ".tif/plans" ]; then
        return
    fi

    printf '\n## Tif Story State (.tif/plans)\n\n'
    find .tif/plans -maxdepth 3 -type f \( -name 'ADR.md' -o -name 'contracts.json' -o -name 'spec_*.md' \) 2>/dev/null \
        | sort \
        | while IFS= read -r file; do
            printf '\n### %s\n\n' "$file"
            sed -n '1,80p' "$file"
            line_count="$(wc -l < "$file" | tr -d ' ')"
            if [ "$line_count" -gt 80 ]; then
                printf '\n[Truncated to first 80 lines of %s]\n' "$file"
            fi
        done
}

build_tif_context() {
    local slug memory_dir session_dir latest_session state_report
    slug="$(project_slug)"
    memory_dir="${HOME}/.tif/memory/${slug}"
    session_dir="${memory_dir}/SESSIONS"
    state_report="$("${PLUGIN_ROOT}/scripts/check-tif-state.sh" . 2>/dev/null || true)"

    {
        printf '<TIF_PROJECT_CONTEXT>\n'
        printf 'Project slug: %s\n' "$slug"
        printf 'Working directory: %s\n' "$(pwd)"
        printf 'Tif plugin root (where scripts/ and skills/ live): %s\n' "${PLUGIN_ROOT}"

        if git rev-parse --git-dir >/dev/null 2>&1; then
            printf '\n## Git Status\n\n'
            git status --short 2>/dev/null || true
            printf '\n## Recent Commits\n\n'
            git log --oneline -10 2>/dev/null || true
        fi

        append_if_exists "Tif Memory" "${memory_dir}/MEMORY.md" 120
        append_if_exists "Tif Failure Modes" "${memory_dir}/FAILURES.md" 120

        if [ -d "$session_dir" ]; then
            latest_session="$(find "$session_dir" -type f -name '*.md' -mtime -7 2>/dev/null | sort | tail -1 || true)"
            if [ -n "$latest_session" ]; then
                append_if_exists "Latest Tif Session" "$latest_session" 80
            fi
        fi

        if [ -n "$state_report" ]; then
            printf '\n## Tif State Contract\n\n'
            printf '%s\n' "$state_report"
        fi

        append_if_exists "Tif PRD (.tif/docs/PRD.md)" ".tif/docs/PRD.md" 140
        append_if_exists "Tif ARCHI (.tif/docs/ARCHI.md)" ".tif/docs/ARCHI.md" 160
        append_if_exists "Tif CONFIG (.tif/docs/CONFIG.md)" ".tif/docs/CONFIG.md" 120
        append_if_exists "Tif Repo Review (.tif/docs/REPO_REVIEW.md)" ".tif/docs/REPO_REVIEW.md" 120
        append_story_state

        printf '\n</TIF_PROJECT_CONTEXT>'
    }
}

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_tif_escaped=$(escape_for_json "$using_tif_content")
warning_escaped=$(escape_for_json "$warning_message")
tif_context_content="$(build_tif_context 2>/dev/null || true)"
tif_context_escaped=$(escape_for_json "$tif_context_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have Tif, a cross-harness SWE workflow.\n\n**Below is the full content of your 'using-tif' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_tif_escaped}\n\n${warning_escaped}\n\n${tif_context_escaped}\n</EXTREMELY_IMPORTANT>"

# Output context injection as JSON. Claude Code and Codex both accept
# hookSpecificOutput.additionalContext for SessionStart.
# Uses printf instead of heredoc to avoid shell compatibility issues.
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0
